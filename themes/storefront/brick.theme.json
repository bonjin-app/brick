{
  "name": "storefront",
  "version": "1.0.0",
  "displayName": "Storefront",
  "description": "상품이 주인공인 쇼핑몰 테마 — 유틸 띠·검색 줄·카테고리 메뉴의 3단 헤더, 넓은 상품 격자, 고객센터가 큰 푸터.",
  "author": "Brick",
  "brickVersion": "^0.2.0",
  "templates": {
    "layout": "templates/layout.html",
    "home": "templates/home.html",
    "page": "templates/page.html"
  },
  "assets": "assets",
  "csp": {
    "style-src": [
      "https://cdn.jsdelivr.net"
    ],
    "font-src": [
      "https://cdn.jsdelivr.net"
    ]
  },
  "tokens": {
    "color-primary": "#111318",
    "color-primary-hover": "#2b2f38",
    "color-primary-soft": "#f1f2f5",
    "color-primary-text": "#111318",
    "color-on-primary": "#ffffff",
    "color-bg": "#ffffff",
    "color-bg-soft": "#fafafb",
    "color-bg-sunken": "#f4f5f7",
    "color-text": "#111318",
    "color-text-soft": "#4a4f59",
    "color-muted": "#6b6e77",
    "color-line": "#e6e8ec",
    "color-line-strong": "#c9ccd3",
    "color-danger": "#d92c3c",
    "color-success": "#12855a",
    "color-warning": "#a2650a",
    "shadow-sm": "0 1px 2px rgba(17, 19, 24, .05)",
    "shadow-md": "0 6px 20px rgba(17, 19, 24, .08)",
    "font-body": "'Pretendard Variable', Pretendard, -apple-system, BlinkMacSystemFont, system-ui, 'Apple SD Gothic Neo', 'Malgun Gothic', 'Segoe UI', Roboto, sans-serif",
    "font-display": "'Pretendard Variable', Pretendard, -apple-system, BlinkMacSystemFont, system-ui, 'Apple SD Gothic Neo', 'Malgun Gothic', sans-serif",
    "font-mono": "ui-monospace, SFMono-Regular, 'SF Mono', Menlo, Consolas, monospace",
    "radius": "3px",
    "radius-lg": "6px",
    "content-width": "1280px",
    "dark-color-primary": "#f2f3f6",
    "dark-color-primary-hover": "#ffffff",
    "dark-color-primary-soft": "#22252c",
    "dark-color-primary-text": "#e9eaef",
    "dark-color-on-primary": "#14161b",
    "dark-color-bg": "#14161b",
    "dark-color-bg-soft": "#1a1d23",
    "dark-color-bg-sunken": "#101216",
    "dark-color-text": "#eceef3",
    "dark-color-text-soft": "#b9bec9",
    "dark-color-muted": "#9297a2",
    "dark-color-line": "#282c34",
    "dark-color-line-strong": "#3a3f49",
    "dark-color-danger": "#ff6b78",
    "dark-color-success": "#3ec98d",
    "dark-color-warning": "#e0a83c"
  }
}
