{
  "name": "editorial",
  "version": "0.1.0",
  "displayName": "Brick Editorial",
  "description": "잡지·신문의 지면처럼 — 종이색 배경, 명조 제목, 가운데 제호와 얇은 괘선. 기본 테마와 같은 프리미티브 계약을 다른 인상으로 구현한 두 번째 동봉 테마.",
  "brickVersion": ">=0.0.1",
  "templates": {
    "layout": "templates/layout.html",
    "home": "templates/home.html",
    "page": "templates/page.html"
  },
  "tokens": {
    "color-primary": "#1c1a17",
    "color-primary-hover": "#3a3630",
    "color-primary-soft": "#efe9df",
    "color-primary-text": "#1c1a17",
    "color-on-primary": "#fbf8f2",
    "color-bg": "#fbf8f2",
    "color-bg-soft": "#f3eee4",
    "color-bg-sunken": "#e9e2d5",
    "color-text": "#1c1a17",
    "color-text-soft": "#4a453d",
    "color-muted": "#6f685c",
    "color-line": "#e2dbcd",
    "color-line-strong": "#c4bba8",
    "color-danger": "#a8302a",
    "color-success": "#2c6b46",
    "color-warning": "#8a5a08",
    "shadow-sm": "0 1px 0 rgba(28, 26, 23, .06)",
    "shadow-md": "0 2px 0 rgba(28, 26, 23, .08)",
    "font-body": "'Pretendard Variable', Pretendard, -apple-system, BlinkMacSystemFont, system-ui, 'Apple SD Gothic Neo', 'Malgun Gothic', 'Segoe UI', Roboto, sans-serif",
    "font-display": "'Noto Serif KR', 'Nanum Myeongjo', 'Apple Myungjo', 'AppleMyungjo', Batang, 'Noto Serif CJK KR', Georgia, 'Times New Roman', serif",
    "font-mono": "ui-monospace, SFMono-Regular, 'SF Mono', Menlo, Consolas, monospace",
    "radius": "2px",
