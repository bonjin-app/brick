    "dark-color-text": "#f2ede3",
    "dark-color-text-soft": "#cfc7b8",
    "dark-color-muted": "#a39b8c",
    "dark-color-line": "#2f2a22",
    "dark-color-line-strong": "#4a4335",
    "dark-color-danger": "#ff8a7f",
    "dark-color-success": "#78cf9f",
    "dark-color-warning": "#e5b95e",
