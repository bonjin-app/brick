# ── Brick 설정 ────────────────────────────────────────
# 이 파일을 .env 로 복사해서 사용하세요: cp .env.example .env

# 필수: 세션/쿠키 서명 키. 반드시 직접 생성하세요.
#   openssl rand -base64 32
BRICK_SECRET=

# PostgreSQL 비밀번호 (docker compose 사용 시)
POSTGRES_PASSWORD=brick

# ── 직접 실행(개발)할 때만 필요 ──────────────────────────
DATABASE_URL=postgresql://brick:brick@localhost:5432/brick

# 공개 웹(Next.js) 포트 — 사용자가 접속하는 유일한 포트
PORT=3000
# 내부 API(NestJS) — 외부 노출 금지
BRICK_API_PORT=3001
BRICK_API_URL=http://localhost:3001

# 메일 링크(비밀번호 재설정 등)에 사용하는 공개 주소.
# 프로덕션에서는 실제 도메인으로 반드시 바꾸세요.
BRICK_SITE_URL=http://localhost:3000

# ── 메일 (선택 — 없으면 콘솔에 출력) ───────────────────
# 비밀번호 재설정 메일을 실제로 보내려면 설정하세요.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=Brick <noreply@example.com>
# SMTP_SECURE=false      # 465 포트면 true (미지정 시 포트로 자동 판단)

# ── 선택 설정 ────────────────────────────────────────
# 리버스 프록시 뒤에 있으면 true (X-Forwarded-For 신뢰)
# BRICK_TRUST_PROXY=false

# 업로드 최대 크기(MB)
# BRICK_MAX_UPLOAD_MB=50

# 부팅 시 자동 마이그레이션 비활성화 (기본: 활성)
# BRICK_AUTO_MIGRATE=false

# 캐시/큐를 Redis로 (미설정 시 PostgreSQL 기반 기본 구현)
# REDIS_URL=redis://localhost:6379

# 스토리지 (미설정 시 로컬 디스크)
# STORAGE_DRIVER=s3
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
