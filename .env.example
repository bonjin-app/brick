# ── Brick 필수 설정 ──────────────────────────────
# PostgreSQL 연결 문자열 (유일한 필수 의존성)
DATABASE_URL=postgresql://brick:brick@localhost:5432/brick

# 세션/토큰 서명 키 (설치 마법사가 자동 생성)
BRICK_SECRET=change-me

# ── 선택 설정 (없으면 PostgreSQL 기반 기본 구현 사용) ──
# REDIS_URL=redis://localhost:6379
# STORAGE_DRIVER=local            # local | s3 | r2
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# ── 포트 ──
# 공개 웹(Next.js). 사용자가 접속하는 유일한 포트
PORT=3000
# 내부 API(NestJS). 외부 노출 금지
BRICK_API_PORT=3001
BRICK_API_URL=http://localhost:3001
